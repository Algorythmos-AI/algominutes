{
  "name": "algominutes",
  "version": "0.1.0",
  "private": true,
  "description": "AlgoMinutes — AI meeting recorder. Native iOS, native Android, and a React web app. © 2026 Algorythmos Pty Ltd.",
  "license": "UNLICENSED",
  "author": "Algorythmos Pty Ltd",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/web",
    "apps/site"
  ],
  "scripts": {
    "gitleaks": "gitleaks detect --source . --config .gitleaks.toml --no-banner",
    "invariants": "bash scripts/check-no-silent-catch.sh && bash scripts/check-no-console.sh && bash scripts/check-no-genai-import.sh && node scripts/check-declared-deps.mjs",
    "migrate": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "typecheck": "npm run typecheck -w @algominutes/contracts -w @algominutes/db -w @algominutes/ai -w @algominutes/tokens",
    "contracts:openapi": "npm run openapi --workspace @algominutes/contracts --if-present",
    "contracts:models": "npm run models --workspace @algominutes/contracts --if-present",
    "test:node": "node --test services/transcoder/test/providers.test.mjs services/transcoder/test/stt.test.mjs && node --test evals/diarisation/der.test.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
