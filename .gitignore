# ── Secrets & credentials (NEVER commit — see docs/EXTRACTION-AUDIT.md §5) ──
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.key
*.keystore
*.jks
*.mobileprovision
*.provisionprofile
**/serviceAccount*.json
**/service-account*.json
# Firebase per-project configs are regenerated per environment (A4), never committed
google-services.json
GoogleService-Info.plist
.firebaserc
firebase-applet-config.json
.firebase/

# ── Node / JS ──
node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.pnpm-store/

# ── Web (Vite) ──
apps/web/dist/
apps/web/.vite/

# ── iOS / Xcode ──
apps/ios/**/build/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcuserstate
Pods/
# xcodegen output (generated from project.yml) is ignored by apps/ios/.gitignore,
# which keeps only the committed Package.resolved. A directory rule here would
# stop it re-including that file.

# ── Android / Gradle ──
.gradle/
apps/android/**/build/
apps/android/.idea/
local.properties
captures/
*.apk
*.aab

# ── Cloud Run / build artifacts ──
*.log
tmp/
.DS_Store

# ── Tooling ──
.claude/settings.local.json
.vscode/
*.swp
# Lighthouse CI reports (apps/site/lighthouserc.json)
.lighthouseci/
