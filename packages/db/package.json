{
  "name": "@algominutes/db",
  "version": "0.1.0",
  "private": true,
  "description": "AlgoMinutes single-Postgres schema, migrations, and repo layer. All note mutations go through here.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db.ts",
    "./notes-repo": "./src/notes-repo.ts",
    "./note-speakers-repo": "./src/note-speakers-repo.ts",
    "./push-tokens-repo": "./src/push-tokens-repo.ts",
    "./migrator": "./src/migrator.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "migrate": "tsx ../../scripts/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@algominutes/ai": "*",
    "@algominutes/contracts": "*",
    "pg": "^8.13.0",
    "pgvector": "^0.2.0",
    "firebase-admin": "^13.0.2"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  }
}
