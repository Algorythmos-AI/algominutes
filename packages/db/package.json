{
  "name": "@algominutes/db",
  "version": "0.1.0",
  "private": true,
  "description": "AlgoMinutes single-Postgres schema, migrations, and repo layer. All note mutations go through here.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db.ts",
    "./notes-repo": "./src/notes-repo.ts",
    "./note-speakers-repo": "./src/note-speakers-repo.ts",
    "./search-repo": "./src/search-repo.ts",
    "./embeddings": "./src/embeddings.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "migrate": "tsx ../../scripts/migrate.ts"
  },
  "dependencies": {
    "@algominutes/ai": "*",
    "@algominutes/contracts": "*",
    "pg": "^8.13.0"
  }
}
