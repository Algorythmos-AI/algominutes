  "typography": {
    "$comment": "TODO(brand): final typeface. Provisional system stack (no client brand fonts shipped). Sizes in px; lineHeight unitless; weights are CSS/Compose numeric.",
    "fontFamily": {
      "heading": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "body": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "mono": "ui-monospace, 'SF Mono', 'Roboto Mono', monospace"
    },
    "scale": {
      "display": { "size": 34, "lineHeight": 1.18, "weight": 700, "tracking": "-0.01em" },
      "title1": { "size": 28, "lineHeight": 1.2, "weight": 700, "tracking": "-0.01em" },
      "title2": { "size": 22, "lineHeight": 1.25, "weight": 600, "tracking": "0" },
