      "gradientStart": "#3716DF",
      "gradientEnd": "#6A2DF2",
      "glyph": "#FFFFFF",
      "dot": "#D9D1FF",
      "dotOnLight": "#6C32F0",
      "navy": "#120C33",
      "ink": "#1B1440",
      "lavender": "#C9BEFF",
      "byline": "#6B6880"
    }
