{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-site.mjs 4322",
      "startServerReadyPattern": "serving apps/site/dist",
      "url": [
        "http://localhost:4322/",
        "http://localhost:4322/privacy",
        "http://localhost:4322/terms",
        "http://localhost:4322/support",
        "http://localhost:4322/delete-account"
      ],
      "numberOfRuns": 1,
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
