# AlgoMinutes web client — build-time env (Vite). Copy to .env.local and fill in.
# These are PUBLIC, domain-restricted Firebase client keys, not secrets — but the
# real per-environment values are regenerated at A4 and never committed.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# API base (services/api). Defaults to the local dev server if unset.
VITE_API_BASE_URL=http://localhost:8080/v1
