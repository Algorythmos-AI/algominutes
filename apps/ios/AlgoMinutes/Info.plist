<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>AlgoMinutes</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>Logo</string>
	</dict>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>$(MICROPHONE_USAGE_DESCRIPTION)</string>
	<key>NSCameraUsageDescription</key>
	<string>AlgoMinutes uses the camera only when you choose to scan text from a document. The image stays on your iPhone: only the text read from it is saved to your notes. It is never used for tracking or advertising.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>AlgoMinutes opens your photo library only when you pick images to scan text from or to make a PDF. Only the images you choose are read, on your iPhone; only the text read from them is saved to your notes.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>AlgoMinutesAPIBaseURL</key>
	<string>$(API_BASE_URL)</string>
	<key>AlgoMinutesBillingBaseURL</key>
	<string>$(BILLING_BASE_URL)</string>
	<key>AlgoMinutesUpdateURL</key>
	<string>$(UPDATE_URL)</string>
	<key>AlgoMinutesPaywallEnabled</key>
	<string>$(PAYWALL_ENABLED)</string>
	<key>AlgoMinutesInviteCodesEnabled</key>
	<string>$(INVITE_CODES_ENABLED)</string>
	<key>AlgoMinutesCallCaptureEnabled</key>
	<string>$(CALL_CAPTURE_ENABLED)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<!-- Google Sign-In: set at build time to GoogleService-Info.plist's
			     REVERSED_CLIENT_ID (project.yml post-build script). -->
			<key>CFBundleURLSchemes</key>
			<array>
				<string>reversed-client-id-set-at-build</string>
			</array>
		</dict>
		<dict>
			<!-- algominutes:// deep links (DeepLinkRouter). -->
			<key>CFBundleURLName</key>
			<string>com.algorythmos.algominutes</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>algominutes</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
