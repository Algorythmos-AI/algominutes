# Firebase iOS config contains an API key; the repo's gitleaks policy blocks
# all AIza matches except firebase-applet-config.json. Fetch it locally with:
#   staging: npx firebase-tools apps:sdkconfig ios 1:627101926311:ios:1fa4a08d6de221d419ac82 \
#     --project algominutes-staging > AlgoMinutes/Resources/GoogleService-Info.plist
#   (the build writes its REVERSED_CLIENT_ID into the app's URL schemes)
AlgoMinutes/Resources/GoogleService-Info.plist

# XcodeGen output — regenerate with `xcodegen generate`
AlgoMinutes.xcodeproj/

